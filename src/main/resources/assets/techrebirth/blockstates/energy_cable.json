{
  "multipart": [
    {
      "apply": { "model": "techrebirth:block/cable/energy_cable_center" }
    },
    {
      "when": { "north": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_side", "y": 0 }
    },
    {
      "when": { "south": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_side", "y": 180 }
    },
    {
      "when": { "east": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_side", "y": 90 }
    },
    {
      "when": { "west": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_side", "y": 270 }
    },
    {
      "when": { "up": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_vertical" }
    },
    {
      "when": { "down": true },
      "apply": { "model": "techrebirth:block/cable/energy_cable_vertical", "x": 180 }
    }
  ]
}